=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/42c83d7b920e790692daabab7bc41beb.mp4?t=1770390681\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/cf23a1abbc93e04f33856fe19141c84f.poster.avif?t=1770390681\" width=800 height=422 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/cf23a1abbc93e04f33856fe19141c84f.webm?t=1770390681\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/cf23a1abbc93e04f33856fe19141c84f.mp4?t=1770390681\" type=\"video/mp4\"></video></span><br><br>Customize workpieces to fit your needs, by choosing materials and size.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/55698203abcb6cd1f02e56cdcd3eedc3.poster.avif?t=1770390681\" width=800 height=424 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/55698203abcb6cd1f02e56cdcd3eedc3.webm?t=1770390681\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/55698203abcb6cd1f02e56cdcd3eedc3.mp4?t=1770390681\" type=\"video/mp4\"></video></span><br><br>Get everything done with realistic physics and movement. And don't forget your cutting tools can break!<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extras/1a3d5d322cc903c35aef0e3aaddbc6e5.poster.avif?t=1770390681\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1787960/extra