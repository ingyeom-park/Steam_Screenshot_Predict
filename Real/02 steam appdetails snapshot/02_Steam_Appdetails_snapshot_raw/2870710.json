lass=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2870710/extras/b38e25718e9576d97f82c631638822ea.poster.avif?t=1765942349\" width=480 height=260 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2870710/extras/b38e25718e9576d97f82c631638822ea.webm?t=1765942349\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2870710/extras/b38e25718e9576d97f82c631638822ea.mp4?t=1765942349\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
