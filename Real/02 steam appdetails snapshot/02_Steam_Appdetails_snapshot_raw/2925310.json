em_assets/steam/apps/2925310/extras/141431f3e69a5e580e8fecda063bbf09.mp4?t=1767605128\" type=\"video/mp4\"></video></span><br><br>Additionally, we've included a photo mode for players to capture intriguing moments from the comic, allowing them to colorize and share their creations with the world.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2925310/extras/fb795fdc2d5584763df3a1a20df61c35.poster.avif?t=1767605128\" width=462 height=260 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2925310/extras/fb795fdc2d5584763df3a1a20df61c35.webm?t=1767605128\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2925310/extras/fb795fdc2d5584763df3a1a20df61c35.mp4?t=1767605128\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2925310/extras/c81fa7167fdb3615313064fa52cf47ac.poster.avif?t=1767605128\" width=616 height=90 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2925310/extras/c81fa7167fdb3615313064fa52cf47ac.webm?t=1767605128\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2925310/extras/c81fa7167fdb3615313064fa52cf47ac.mp4?t=1767605128\" type=\"video/mp4\"></video></span></th></tr></table>",
