ine poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3618390/extras/80622e3e6993dd788af33bec3330ae08.poster.avif?t=1771280235\" width=1170 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3618390/extras/80622e3e6993dd788af33bec3330ae08.webm?t=1771280235\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3618390/extras/80622e3e6993dd788af33bec3330ae08.mp4?t=1771280235\" type=\"video/mp4\"></video></span></p>",
